{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "commitlint.config.mjs",
      "tests/**/*.mjs",
      "scripts/vendor-chart.mjs",
      "obox_builder/contrib/analytics/static/analytics.js",
      "obox_builder/contrib/analytics/static/analytics.css",
      "obox_builder/builder/static/**/*.js",
      "obox_builder/contrib/files/static/**/*.js",
      "obox_builder/contrib/files/static/**/*.css",
      "obox_builder/builder/**/*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    }
  }
}
