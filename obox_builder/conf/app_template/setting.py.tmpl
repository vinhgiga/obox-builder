import os
from pathlib import Path

from obox_builder import Settings
from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine

BASE_DIR = Path(__file__).resolve().parent
PROJECT_NAME = "__PROJECT_NAME__"
DEBUG = os.getenv("OBOX_DEBUG", "true").lower() in {"1", "true", "yes", "on"}
DATABASE_URL = os.getenv(
    "OBOX_DATABASE_URL", f"sqlite+aiosqlite:///{BASE_DIR / 'db.sqlite3'}"
)
# SECURITY WARNING: keep the secret key used in production secret!
# Do not commit this key; set OBOX_SECRET_KEY in deployment environments.
SECRET_KEY = os.getenv("OBOX_SECRET_KEY", "__SECRET_KEY__")

engine = create_async_engine(DATABASE_URL)
OBOX = Settings(
    session_factory=async_sessionmaker(engine, expire_on_commit=False),
    csrf_secret=SECRET_KEY,
)
