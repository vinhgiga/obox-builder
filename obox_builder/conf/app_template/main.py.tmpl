import setting
from fastapi import FastAPI, Request
from fastapi.responses import RedirectResponse
from obox_builder import Obox
from obox_builder.contrib.auth import Auth

app = FastAPI(title=setting.PROJECT_NAME, debug=setting.DEBUG)

if (setting.FRONTEND_DIR / "index.html").is_file():
    app.frontend("/", directory=setting.FRONTEND_DIR)
else:
    @app.get("/", include_in_schema=False)
    def index(request: Request) -> RedirectResponse:
        return RedirectResponse(url=request.url_for("obox_index"), status_code=307)

obox = Obox(app=app, plugins=(Auth(secure=not setting.DEBUG),))
