<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ project_name }}</title>
    <link rel="stylesheet" href="{{ request.url_for('obox_static', path='tabler.min.css') }}">
    <link rel="stylesheet" href="{{ request.url_for('obox_static', path='ui.css') }}">
  </head>
  <body class="page">
    <div class="page-wrapper">
      <header class="navbar navbar-expand-md bg-white border-bottom">
        <div class="container-fluid">
          <a class="navbar-brand" href="{{ request.url_for('index') }}">{{ project_name }}</a>
          <nav class="navbar-nav flex-row gap-3 ms-auto" aria-label="Main navigation">
            <a class="nav-link" href="{{ request.url_for('swagger_ui_html') }}">API docs</a>
            <a class="nav-link" href="{{ request.url_for('obox_login') }}">Sign in</a>
            {% if frontend_url %}
              <a class="nav-link" href="{{ frontend_url }}">Frontend</a>
            {% endif %}
          </nav>
        </div>
      </header>
      <nav class="nav nav-tabs flex-nowrap overflow-x-auto overflow-y-hidden bg-white px-3"
           aria-label="Pages">
        {% for page in pages %}
          <a class="nav-link" href="{{ page.url }}">{{ page.label }}</a>
        {% endfor %}
      </nav>
      <main class="page-body record-page" id="main" tabindex="-1">
        <div class="container-xl">
          <h1 class="page-title mb-3">{{ project_name }}</h1>
          <div class="record-content card card-body">
            {% if pages %}
              <p>Choose a page from the navigation above.</p>
            {% else %}
              <p>No pages are available yet.</p>
            {% endif %}
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
