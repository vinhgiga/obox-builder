"""$${message}

Revision ID: $${up_revision}
Revises: $${down_revision | comma,n}
Create Date: $${create_date}

"""
from collections.abc import Sequence

from alembic import op
import sqlalchemy as sa
$${imports if imports else ""}

revision: str = $${repr(up_revision)}
down_revision: str | None = $${repr(down_revision)}
branch_labels: str | Sequence[str] | None = $${repr(branch_labels)}
depends_on: str | Sequence[str] | None = $${repr(depends_on)}


def upgrade(engine_name: str) -> None:
    operation = globals().get(f"upgrade_{engine_name}")
    if operation is None:
        raise RuntimeError(f"Revision {revision} has no operations for database {engine_name!r}.")
    operation()


def downgrade(engine_name: str) -> None:
    operation = globals().get(f"downgrade_{engine_name}")
    if operation is None:
        raise RuntimeError(f"Revision {revision} has no operations for database {engine_name!r}.")
    operation()

<%
database_names = config.get_main_option("databases", "").split(",")
%>
% for database_name in database_names:
def upgrade_$${database_name}() -> None:
    $${context.get(f"{database_name}_upgrades", "pass")}


def downgrade_$${database_name}() -> None:
    $${context.get(f"{database_name}_downgrades", "pass")}


% endfor
