from pathlib import Path

from obox_builder.conf import BaseSettings
from pydantic import SecretStr

BASE_DIR = Path(__file__).resolve().parent.parent


class Settings(BaseSettings):
    # Provide a production secret through the OBOX_SECRET_KEY environment variable.
    SECRET_KEY: SecretStr = SecretStr("$secret_key")

    DEBUG: bool = True
    DATABASE_URL: str = f"sqlite+aiosqlite:///{BASE_DIR / 'db.sqlite3'}"
    ALLOWED_HOSTS: list[str] = ["localhost", "127.0.0.1", "[::1]", "testserver"]

    INSTALLED_APPS: list[str] = [
        "obox_builder.contrib.auth",
        "obox_builder.contrib.admin",
        # Add your apps here, for example "apps.blog".
    ]
    MIDDLEWARE: list[str] = [
        "obox_builder.contrib.i18n.middleware.LocaleMiddleware",
        "obox_builder.core.middleware.request_id.RequestIDMiddleware",
        "obox_builder.core.middleware.security_headers.SecurityHeadersMiddleware",
    ]
    ROOT_URLCONF: str = "$project_name.urls"
    ASGI_APPLICATION: str = "$project_name.asgi.application"
    TEMPLATE_DIRS: list[Path] = [BASE_DIR / "templates"]
    LOCALE_PATHS: list[Path] = [BASE_DIR / "locale"]
    STATIC_ROOT: Path = BASE_DIR / "static"
