# Copy to .env and adjust. Real values override config/settings.py defaults.
OBOX_SETTINGS_MODULE=config.settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OBOX_SECRET_KEY=replace-me
OBOX_DEBUG=false
OBOX_DATABASE_URL=sqlite+aiosqlite:///db.sqlite3
# Replace these with the exact production hostnames before deployment.
OBOX_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
# Enable only when the ASGI server receives the trusted HTTPS scheme from its proxy.
OBOX_SECURE_SSL_REDIRECT=false
# Configure HSTS here or at the trusted edge proxy after HTTPS is working.
OBOX_SECURE_HSTS_SECONDS=0
